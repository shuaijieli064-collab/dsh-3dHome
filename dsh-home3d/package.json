{
  "name": "dsh-home3d",
  "version": "0.1.0",
  "description": "把「马维斯的小家」3D 场景作为主区面板装进 DeepSeek Harness 桌面端：左侧栏多一行，点开即渲染小屋",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "build.mjs",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "MIT"
}
